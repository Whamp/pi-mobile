{
	"name": "pi-mobile",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "node src/server/main.ts",
		"dev": "node scripts/dev.mjs",
		"build": "tsc",
		"check": "node scripts/biome-check.mjs && tsc --noEmit",
		"format": "node scripts/biome-check.mjs --write",
		"test": "node --test --test-concurrency=1 test/*.test.ts",
		"torture": "node scripts/torture.ts",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@biomejs/js-api": "4.0.0",
		"@biomejs/wasm-nodejs": "2.3.5",
		"@types/node": "22.19.19",
		"@types/proper-lockfile": "4.1.4",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@types/ws": "8.18.1",
		"@vitejs/plugin-react": "6.1.1",
		"husky": "9.1.7",
		"playwright": "1.64.0",
		"typescript": "5.9.3",
		"vite": "8.3.2"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@earendil-works/chord": "1.3.0",
		"@earendil-works/pi-ai": "1.3.0",
		"@earendil-works/pi-codemode": "1.3.0",
		"@earendil-works/pi-durable": "1.3.0",
		"lowlight": "3.3.0",
		"proper-lockfile": "4.1.2",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"typebox": "1.3.27",
		"ws": "8.22.0",
		"yaml": "2.9.1"
	}
}
